# Local application. No login or platform credentials are required.
# Configure an OpenAI-compatible model provider for AI requests.
MODEL_USE=openai/your-model-name
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=

# Optional research services: only needed for their respective features.
TAVILY_API_KEY=
MP_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
EASYSCHOLAR_API_KEY=

RESEARCHMIND_HTTP_HOST=127.0.0.1
RESEARCHMIND_HTTP_PORT=50002
RESEARCHMIND_WS_HOST=127.0.0.1
RESEARCHMIND_WS_PORT=50003
PAPER_SEARCH_MCP_HOST=127.0.0.1
PAPER_SEARCH_MCP_PORT=50004
PAPER_SEARCH_MCP_URL=http://127.0.0.1:50004/sse
SIMULATION_MCP_HOST=127.0.0.1
SIMULATION_MCP_PORT=50005
SIMULATION_MCP_URL=http://127.0.0.1:50005/sse
DATABASE_MCP_HOST=127.0.0.1
DATABASE_MCP_PORT=50006
DATABASE_MCP_URL=http://127.0.0.1:50006/sse

# Optional Redis cache; file storage works when Redis is unavailable.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

SESSION_DATA_ROOT=data/session_data
PAPERS_ROOT=data/papers
PHONON_ROOT=data/phonon
CHROMA_PERSIST_DIR=data/chroma

VITE_FRONTEND_HOST=127.0.0.1
VITE_FRONTEND_PORT=50010
VITE_API_URL=/api
VITE_WS_URL=/ws

TOKEN_STATS_ENABLED=true
RESEARCHMIND_LOG_LEVEL=INFO
RESEARCHMIND_DEBUG=false
