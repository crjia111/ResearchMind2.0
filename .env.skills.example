# Portable runtime uses the same third-party service settings as the local app.
# Never put real credentials into committed skill resources.
RESEARCHMIND_WORKSPACE=./data/skill-runtime
MODEL_USE=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TAVILY_API_KEY=
MP_API_KEY=
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# Alternative embedding provider; must be explicitly selected.
OPENAI_EMBEDDING_MODEL=
# Local model/data paths; not downloaded implicitly.
MATTERSIM_MODEL_PATH=
GNOME_DATA_DIR=
CRYSTALLM_MODEL_DIR=
KAPPA_MODEL_DIR=
KAPPA_ATOM_INIT=
